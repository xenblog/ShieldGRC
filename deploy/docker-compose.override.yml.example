# Reference only - NOT read by anything.
#
# The post-receive hook (deploy/post-receive) writes the real
# docker-compose.override.yml fresh into /opt/dagrofashield/deploy on every
# deploy, so it can never go stale or get wiped by `git checkout -f`. Do
# not copy this file onto the box by hand.
#
# It stays this small on purpose: the base docker-compose.yml already has
# no host port mapping for backend/postgres (nothing to remove), and
# backend/postgres already read their config via ${VAR} interpolation from
# docker-compose.yml - the hook supplies that by invoking `docker compose`
# with `--env-file /opt/dagrofashield/.env` rather than by adding an
# env_file: block here. nginx is excluded by only ever starting
# "postgres backend frontend" explicitly, not by anything in this file.
#
# `name:` is the important line for this box specifically: it's what
# actually guarantees every container/network/volume this stack creates is
# prefixed "dagrofashield_" and can never collide with the box's other,
# unrelated docker compose project at /opt/docker-compose.yaml - regardless
# of which directory a command happens to be run from. The hook also never
# runs `docker compose` from /opt itself, only from /opt/dagrofashield/deploy,
# as a second, independent guard against the same collision.
name: dagrofashield
services:
  frontend:
    ports:
      - "3000:3000"
