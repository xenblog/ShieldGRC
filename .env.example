# Copy this file to .env and fill in real values before running
# docker compose up. Never commit the real .env file.

# --- Postgres ---
POSTGRES_USER=dagrofashield
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=dagrofashield

# --- Backend / auth ---
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Public origin of the frontend (used for CORS and for the redirect target
# after Entra ID SSO login). In production this is your https:// domain.
FRONTEND_ORIGIN=http://localhost:3000

# --- Entra ID (Azure AD) SSO - optional ---
# Leave all four blank to run with local-account login only (e.g. local dev,
# or a break-glass admin account). Fill them in to enable the "Sign in with
# Microsoft Entra ID" button.
# App registration: Azure Portal > Entra ID > App registrations > New registration.
# Redirect URI must be <your https domain>/api/auth/entra/callback (Web platform).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://your-domain.example.com/api/auth/entra/callback
# Role assigned to a user the very first time they sign in via Entra ID.
# Keep this the least-privileged role (AUDITOR) - an Admin promotes users
# and assigns org units afterward. One of: ADMIN, RISK_OWNER, AUDITOR, EXECUTIVE.
ENTRA_DEFAULT_ROLE=AUDITOR
